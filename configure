#!/bin/sh
#alt: #! /usr/bin/env bash
#config: to debug this script add also '-x' to the set below
set -eu

###############################################################################
# Prelude
###############################################################################
# The goal of this script is to automate the configuration and installation
# of packages that are needed to then compile and install goken itself.
#
# The goal is also to use a single command that can work on all platforms:
#  - Linux (Alpine for Docker, Ubuntu for Github Actions, Arch/Nix/...)
#  - macOS (native, HomeBrew, macPort, Nix)
#  - Windows (Cygwin, Mingw, WSL)
# and that setup everything (e.g., gcc/clang, mk/rc).
#
# This is reminescent of the classic "configure; make; make install"
# trifecta of building and installing GNU packages, but adapted to the
# new world of software development with powerful package managers and
# software possibly written using multiple programming languages.
#
# This script currently assumes that gcc (and binutils) as well as
# a few other utilities (e.g., make, bash) have already been installed.
#
# TODO: 
#  - check for gcc/clang
#  - detect if bin/ contains mk, rc, and ed
#    and maybe run scripts/build-mk.sh and promote-mk.sh automatically

###############################################################################
# Entry point
###############################################################################

# Parse options
SANITIZE=
CCKIND=gcc
for arg in "$@"; do
    case "$arg" in
        --asan)
            SANITIZE='-fsanitize=address'
            ;;
        --clang)
            CCKIND=clang
            ;;
        --help|-h)
            echo "Usage: ./configure [options]"
            echo "  --asan    Build with AddressSanitizer (memory error detector)"
            echo "  --clang   Bootstrap goken with clang instead of gcc"
            exit 0
            ;;
        *)
            echo "Unknown option: $arg" >&2
            echo "Try: ./configure --help" >&2
            exit 1
            ;;
    esac
done

#TODO: imitate what x9cc/configure does
ARCH=`uname -m`
case "$ARCH" in
    x86_64)
        CPUTYPE=amd64
        ;;
    aarch64 | arm64)
        CPUTYPE=arm64
        ;;
    *)
        echo "Unsupported architecture: $ARCH" >&2
        exit 1
        ;;
esac

OS=`uname -s`
case "$OS" in
    Linux)
        OSTYPE=linux
        ;;
    Darwin)
        OSTYPE=darwin
        ;;
    CYGWIN*)
        OSTYPE=cygwin
        ;;
    *)
        echo "Unsupported OS: $OS" >&2
        exit 1
        ;;
esac

echo 'Generating ./mkconfig'
#alt: could be set by env.sh
#old: now in mkfiles/$objtype/mkfile
#  O=o
#old: now in mkfiles/mkfile.proto included from mkfiles/$objtype/mkfile
#  CPUS=arm amd64 386
#  OS=568
#
# objtype vs cputype vs ostype: objtype now selects a *build flavor*
# mkfile (mkfiles/boot-gcc or mkfiles/boot-clang), not a CPU. Those
# bootstrap mkfiles use the host C compiler (gcc/clang) to build goken
# itself. cputype is the actual host CPU (amd64/arm64/...) and is what
# ROOT/$cputype/{bin,lib} and the host-specific CFLAGS_ARCH are keyed
# on. This split is what will let a future objtype=self-$cputype mkfile
# set CC=$CC_ (e.g. 7c) to self-host goken with goken instead of gcc.
# ostype is the host OS (linux/darwin/cygwin), the third leg of that
# same "describe the build host" triple -- consumed by the handful of
# mkfiles/scripts that need to know what host they're running on
# (src/libmach/mkfile's $ostype.$O host stub, BOOT/lib9/mkfile's and
# scripts/build-mk.sh's goos.c compile). GOOS is deliberately NOT
# generated here: it means something different (the *target* OS of the
# runtime a given libc.a/binary is built for, e.g. lib_core/libc/mkfile
# cross-building for GOOS=darwin on a Linux host) and those mkfiles
# already set/override it locally rather than relying on mkconfig, so
# conflating it with the host-describing ostype here would be wrong.
echo "objtype=boot-$CCKIND" > mkconfig
echo "cputype=$CPUTYPE" >> mkconfig
echo "ostype=$OSTYPE" >> mkconfig
#still needed? used in golang
#GOHOSTOS=linux
#GOHOSTARCH=amd64
if [ -n "$SANITIZE" ]; then
    # single quotes needed so mk/rc don't choke on the '=' inside the value
    echo "SANITIZE='$SANITIZE'" >> mkconfig
fi

#echo 'Here is the content of the ./mkconfig that configure generated:'
echo 'Here is its content:'
cat mkconfig
echo

#coupling: Dockerfile and README.md and principia/docs/getting-started.html
echo 'Everything looks fine. You can now run: '
echo
echo '   $ ./scripts/build-mk.sh'
echo '   $ ./scripts/promote-mk.sh'
echo '   $ . env.sh'
echo
echo 'and after that: '
echo
echo '   $ mk'
echo '   $ mk install'
echo
echo 'at which point 5c/5a/5l, 8c/8a/8l, mk/rc, ... should be in your $PATH'

