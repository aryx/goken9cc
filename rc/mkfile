TOP=../
<$TOP/mkfiles/$objtype/mkfile

TARG=rc

# -lstring is needed just for one function in processes.c (for `{...})
LDLIBS=-lstring $BOOTLIBS

# claude: -DUnix (rc.h: "assume plan 9 by default; if Unix is defined,
# assume unix") picks rc.h's `#include "unix.h"` branch -- but
# unix.h itself is now just u.h+libc.h (see its own header comment),
# identical to the plan9 branch's own includes, so this stays
# UNCONDITIONAL rather than object-type-conditional: a conditional
# CFLAGS_EXTRA (`if(...) echo -DUnix; if not echo -n`) hits the exact
# "eagerly-substituted one-element empty-string list" pitfall
# mkfiles/mkfile.proto's own BOOTLIBS comment documents -- confirmed by
# testing (`for(i in $X)` with $X bound to an empty-output backquote
# still iterates once, unlike a truly-unassigned variable or a real rc
# `()` literal), and it broke goken.$O's own compile with phantom
# "6c: No such file or directory:" errors on an empty filename
# argument. rc.h's NSIG/SIGINT/SIGQUIT (rc's own trap-slot indices, not
# real signal numbers) were the only thing that actually needed to
# differ per branch, and are unconditional in rc.h now too -- so
# -DUnix can just stay always-on without breaking goken.$O.
CFLAGS_EXTRA=-DUnix

# claude: exactly one of unix.$O/plan9.$O/goken.$O, never more than
# one -- they all define the same symbols (Rcmain/Fdprefix/Vinit/
# Updenv/Waitfor/signame/interrupted/Eintr/Noerror/Opendir/Readdir/
# Closedir/Globsize/Malloc/Exit/Isatty, except goken.$O which leaves
# notifyf/Trapinit to NOTIFYVARIANTOFILES below), so linking two would
# collide. unix.$O is rc's own real-host-libc variant (used for the
# boot-gcc/boot-clang bootstrap build); plan9.$O is for a real Plan9
# host (GOOS=plan9, not exercised by this tree's own build/test
# scripts, same as mk/Plan9.c); goken.$O (docs/claude_notes/
# notes_libc_selfhost.txt's rc self-hosting entry) is for rc built BY
# goken's own toolchain targeting a POSIX-shaped GOOS (linux/darwin/
# windows).
VARIANTOFILES=`{if(~ $objtype boot-gcc boot-clang) echo unix.$O; if not if(~ $GOOS plan9) echo plan9.$O; if not echo goken.$O}

# claude: goken.c itself doesn't define notifyf()/Trapinit() (see its
# own header comment) -- notify()/noted() support isn't uniform across
# linux/darwin/windows (lib_core/libc/mkfile's NOTIFYOFILES), so which
# of these rc needs is picked here, same shape as mk/mkfile's own
# NOTIFYVARIANTOFILES. Only wanted alongside goken.$O itself.
NOTIFYVARIANTOFILES=`{if(~ $objtype boot-gcc boot-clang) echo -n; if not if(~ $GOOS plan9) echo -n; if not if(~ $GOOS linux) echo notify_full.$O; if not echo notify_none.$O}

OFILES=\
	code.$O\
	exec.$O\
	getflags_.$O\
	glob.$O\
	here.$O\
	io.$O\
	lex.$O\
	pcmd.$O\
	pfnc.$O\
	simple.$O\
	trap.$O\
	tree.$O\
	var.$O\
	processes.$O\
     globals.$O\
     utils.$O\
     error.$O\
     words.$O\
     executils.$O\
     status.$O\
     builtins.$O\
     input.$O\
     path.$O\
     env.$O\
     fmt.$O\
     main.$O\
   y.tab.$O \
   $VARIANTOFILES\
   $NOTIFYVARIANTOFILES\

HFILES=rc.h\
	io.h\
	exec.h\
	fns.h\
	getflags.h\
	y.tab.h

YFILES=syn.y

<$TOP/mkfiles/mkone

regress: $O.out
	cd test
	mk

unregress:V:
	for(test in test/*.test) rc $test >$test.out

# Test if you can call mk from mk; the PATH should be set correctly
# and propagated to rc (which must do the right finit that set path from PATH).
recmk:
	mk clean

# ------------------------------------------------------------------------------
VIEWS=$HFILES ${OFILES:%.$O=%.c}
sync:VI:
	for (i in $VIEWS) {
	   if (~ $i y.tab.[ch]) echo skipping $i
	   if not  syncweb -no_cache -verbose -md5sum_in_auxfile -less_marks -lang C $TOP/principia/shells/Shell.nw $TOP/principia/shells/Shell_extra.nw  $i
        }
