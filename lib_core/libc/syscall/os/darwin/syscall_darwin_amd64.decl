// Declarative syscall spec for darwin/amd64, in the spirit of
// GO/pkg/syscall's "//sys name(args) (ret) = SYS_NAME" comments (see
// GO/pkg/syscall/syscall_darwin.go), parsed by scripts/mksyscall.sh into
// zsyscall_darwin_amd64.c. Every wrapper just calls the one generic
// _syscall6 trampoline (lib_core/libc/syscall/os/darwin/svc_amd64.s), so
// adding a syscall here is the only step needed -- no new assembly.
//
// lib_core/libc/mkfile builds this one with the vlong argtype (see
// scripts/mksyscall.sh's own comment, and syscall_darwin_amd64.h's): a
// plain `long` is only 4 bytes even on this 64-bit arch, so a pointer
// argument (e.g. write()'s buf) cast through `(long)` would be
// silently truncated before ever reaching _syscall6.

//sys write(int fd, void *buf, long n) long = SYS_write
//sys read(int fd, void *buf, long n) long = SYS_read
//sys close(int fd) int = SYS_close
// vlong rettype via _syscall6v, not the default _syscall6 -- see
// syscall_linux_amd64.decl's identical comment on lseek.
//sys lseek(int fd, vlong offset, int whence) vlong = SYS_lseek:_syscall6v
// _sysopen, not open: raw 3-arg POSIX shape, distinct from Plan9's 2-arg
// open(char*,int) (include/os/file.h) that os/darwin/open.c builds on
// top of this -- see syscall_linux_amd64.decl's identical comment.
// Unlike the Linux "generic ABI" archs, darwin's BSD table keeps a real
// 3-arg open() (SYS_open), so this needs no openat()/AT_FDCWD detour.
//sys _sysopen(void *path, int flags, int mode) long = SYS_open
// see syscall_linux_386.decl's identical comment: chdir needs no glue,
// while _sysunlink/_sysrmdir/_sysmkdir are raw shapes that port/remove.c
// and os/darwin/open.c bridge into Plan9's remove() and create().
// Darwin's O_CREAT bit is 0x200, not Linux's 0x40, which is exactly the
// kind of difference that keeps create()'s translation per-OS.
//sys _sysunlink(char *path) int = SYS_unlink
//sys _sysrmdir(char *path) int = SYS_rmdir
//sys _sysmkdir(char *path, int mode) int = SYS_mkdir
// access: Plan9's mode bits (AEXIST/AEXEC/AWRITE/AREAD = 0/1/2/4,
// include/os/file.h) are numerically identical to POSIX's
// F_OK/X_OK/W_OK/R_OK, so like chdir this needs no translation and is
// generated straight into its public name.
//sys access(char *path, int mode) int = SYS_access
// dup is _sys-prefixed because Plan9's dup(oldfd, newfd) is ONE call
// covering what POSIX splits in two: newfd == -1 means "lowest free
// fd" (POSIX dup), anything else is dup2. port/dup.c bridges them.
//sys _sysdup(int fd) int = SYS_dup
//sys _sysdup2(int oldfd, int newfd) int = SYS_dup2
//sys chdir(char *path) int = SYS_chdir
//sys exit(int code) void = SYS_exit
// mmap: the primitive os/darwin/sbrk.c is built on, since this GOOS has
// no usable brk (see numbers_darwin_amd64.h). Exactly 6 arguments, which
// is what _syscall6 already carries -- no new assembly needed.
// _syscall6v, not the default _syscall6, because the RETURN value is an
// address: _syscall6 is declared `long`-returning and `long` is 4 bytes
// even on these 64-bit arches, so the mapping's address would be
// truncated. Same reason lseek and linux's _sysbrk need it.
//sys _sysmmap(void *addr, ulong len, int prot, int flags, int fd, vlong offset) uintptr = SYS_mmap:_syscall6v
// the "small tier": getpid, getwd, time/nsec, sleep -- see
// numbers_darwin_amd64.h for why two of these are not the calls the
// Linux side uses (Darwin has neither getcwd nor nanosleep).
//sys getpid(void) int = SYS_getpid
//sys _sysfcntl(int fd, int cmd, void *arg) int = SYS_fcntl
//sys _sysgettimeofday(void *tv, void *tz, void *mach) int = SYS_gettimeofday
//sys _sysselect(int nd, void *in, void *ou, void *ex, void *tv) int = SYS_select
// the stat family (Tier 3). This arch is 64-bit-native like amd64/
// arm64/riscv64 on the Linux side, so ftruncate takes one plain vlong
// argument, no register-pair split needed.
//sys _sysfstat(int fd, void *buf) int = SYS_fstat64
//sys _sysfchmod(int fd, int mode) int = SYS_fchmod
//sys _sysftruncate(int fd, vlong length) int = SYS_ftruncate
// Tier 4 process control (docs/claude_notes/plan_syscalls.txt).
// _sysexecve/_syswait4 are ordinary argument-in-registers,
// result-in-one-register syscalls (unlike fork/pipe, see
// numbers_amd64.h's own comment on why those two need dedicated asm
// in svc_amd64.s instead), so they need no new assembly at all -- same
// as every other entry in this file. Named and shaped identically to
// linux's own _sysexecve/_syswait4 (syscall_linux_amd64.decl), which
// is what lets port/exec.c and port/wait.c -- the Plan9-shaped bridges
// every GOOS shares -- be built unchanged for darwin too (see
// lib_core/libc/mkfile's PROCOFILES).
//sys _sysexecve(void *path, void *argv, void *envp) int = SYS_execve
//sys _syswait4(int pid, void *status, int options, void *rusage) int = SYS_wait4

// Tier 6 notification, postnote() only -- see numbers_amd64.h's own
// comment for why notify()/noted() are not attempted here. A real
// 3-argument BSD kill, unlike every other GOOS in this tree.
//sys _syskill(int pid, int sig, int posix) int = SYS_kill

// rc self-hosting's Isatty() (os/darwin/isatty.c) and
// Readdir()/Opendir() (os/darwin/dirread.c). arg/buf stay void* like
// every other raw stub in this tree -- the raw layer stays free of
// struct definitions.
//sys _sysioctl(int fd, ulong request, void *arg) int = SYS_ioctl
//sys _sysgetdirentries64(int fd, void *buf, ulong bufsize, void *position) int = SYS_getdirentries64
