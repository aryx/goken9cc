// Declarative syscall spec for linux/arm64, in the spirit of
// GO/pkg/syscall's "//sys name(args) (ret) = SYS_NAME" comments (see
// GO/pkg/syscall/syscall_linux.go), parsed by scripts/mksyscall.sh into
// zsyscall_linux_arm64.c. Every wrapper just calls the one generic
// _syscall6 trampoline (lib_core/libc/syscall/os/linux/svc_arm64.s), so
// adding a syscall here is the only step needed -- no new assembly.
//
// lib_core/libc/mkfile builds this one with the vlong argtype (see
// scripts/mksyscall.sh's own comment, and syscall_linux_arm64.h's): a
// plain `long` is only 4 bytes even on this 64-bit arch, so a pointer
// argument (e.g. write()'s buf) cast through `(long)` would be
// silently truncated before ever reaching _syscall6.

//sys write(int fd, void *buf, long n) long = SYS_write
//sys read(int fd, void *buf, long n) long = SYS_read
//sys close(int fd) int = SYS_close
// vlong rettype via _syscall6v, not the default _syscall6 -- see
// syscall_linux_amd64.decl's identical comment on lseek.
//sys lseek(int fd, vlong offset, int whence) vlong = SYS_lseek:_syscall6v
// no legacy SYS_open on this arch (see numbers_arm64.h) -- openat() is
// generated here from SYS_openat, and syscall_linux_arm64.h hand-adds a
// tiny _sysopen(path,flags,mode) shim on top calling openat(AT_FDCWD,...),
// so os/linux/open.c's Plan9-flag-translation glue can call the same
// _sysopen() name uniformly on every Linux arch regardless of which raw
// syscall backs it.
//sys openat(int dirfd, void *path, int flags, int mode) long = SYS_openat
// chdir: Plan9's chdir() (include/os/dir.h) is shaped exactly like
// POSIX chdir(2), so it needs no os/$GOOS/ translation glue and is
// generated straight into its public symbol name -- see
// syscall_linux_386.decl's fuller comment on that, and on why the
// unlink/rmdir/mkdir family is _sys-prefixed instead.
//
// This ABI has no legacy unlink() or mkdir() at all (numbers_arm64.h),
// only the *at() forms -- exactly as it has no open(), only openat().
// So the raw *at() calls are generated here and syscall_linux_arm64.h
// hand-adds the _sysunlink()/_sysrmdir()/_sysmkdir() shims over them,
// the same way it already does _sysopen() over openat(). _sysrmdir()
// is free here: it is unlinkat() with AT_REMOVEDIR, no second number.
//sys unlinkat(int dirfd, char *path, int flags) int = SYS_unlinkat
//sys mkdirat(int dirfd, char *path, int mode) int = SYS_mkdirat
// access/dup: this ABI kept dup but replaced dup2 with dup3 and access
// with faccessat, so syscall_linux_arm64.h shims access() and
// _sysdup2() over them -- see syscall_linux_386.decl for why Plan9's
// dup(oldfd, newfd) needs both dup forms in the first place.
//sys faccessat(int dirfd, char *path, int mode, int flags) int = SYS_faccessat
//sys _sysdup(int fd) int = SYS_dup
//sys dup3(int oldfd, int newfd, int flags) int = SYS_dup3
//sys chdir(char *path) int = SYS_chdir
//sys exit(int code) void = SYS_exit
// brk: the raw kernel primitive -- see syscall_linux_386.decl's comment
// for the return-convention story (os/linux/brk.c bridges it to
// include/os/mem.h's Plan9-shaped 0/-1 brk(), and port/sbrk.c sits on
// top of that). _syscall6v, not the default _syscall6, for the same
// reason lseek above needs it: _syscall6 is declared `long`-returning,
// and `long` is 4 bytes even on this 64-bit arch, so the returned
// break address would be truncated to 32 bits before the (uintptr)
// cast ever saw it. This is the second caller of _syscall6v, and the
// first that is not about a 64-bit *offset*.
//sys _sysbrk(void *addr) uintptr = SYS_brk:_syscall6v
// the "small tier": getpid, getwd, time/nsec, sleep.
// getpid is the only one generated straight into its public name -- it
// takes nothing, returns an int, and Plan9 and POSIX agree exactly.
//sys getpid(void) int = SYS_getpid
// getcwd is _sys-prefixed because the shapes differ twice over: POSIX
// returns the LENGTH written (or -errno), Plan9's getwd() returns the
// buffer (or nil). os/linux/getwd.c bridges it.
//sys _sysgetcwd(char *buf, ulong size) long = SYS_getcwd
// clock_gettime/clock_nanosleep rather than gettimeofday/nanosleep, and
// on the 32-bit arches these numbers are the *_time64 variants -- see
// numbers_$cputype.h for why (the timespec is 8+8 on every arch this
// way, so os/linux/time.c needs no per-arch layout). The timespec is
// passed as void* here for the same reason _sysopen takes void*: the
// raw layer stays free of struct definitions, and os/linux/time.c
// declares the one shape it needs.
//sys _sysclockgettime(int clockid, void *ts) int = SYS_clock_gettime
//sys _sysclocknanosleep(int clockid, int flags, void *req, void *rem) int = SYS_clock_nanosleep
// the stat family (Tier 3) -- see syscall_linux_amd64.decl's identical
// comment on why ftruncate needs no register-pair split here.
//sys _sysfstat(int fd, void *buf) int = SYS_fstat
//sys _sysfchmod(int fd, int mode) int = SYS_fchmod
//sys _sysftruncate(int fd, vlong length) int = SYS_ftruncate
// dirread's other raw call (Tier 3.5) -- openat() itself already
// exists above (this arch's own _sysopen bridge).
//sys _sysgetdents64(int fd, void *buf, uint count) long = SYS_getdents64
// renameat2(2) -- os/linux/dirwstat.c's dirwstat() name-change support
//sys _sysrenameat2(int olddirfd, void *oldpath, int newdirfd, void *newpath, uint flags) long = SYS_renameat2
// Tier 4 process control -- see syscall_linux_386.decl's comment on why
// execve/wait4 stay _sys-prefixed. No legacy fork() or pipe() on this
// ABI (numbers_arm64.h) -- _sysrawclone/_sysrawpipe2 are generated here
// from the *at()-style substitutes (clone, pipe2), exactly like
// openat()/unlinkat() above, and syscall_linux_arm64.h hand-adds the
// fork()/pipe() shims over them the same way it already does
// _sysopen() over openat().
//sys _sysrawclone(int flags, void *stack, void *ptid, void *ctid, void *tls) int = SYS_clone
//sys _sysexecve(void *path, void *argv, void *envp) int = SYS_execve
//sys _syswait4(int pid, void *status, int options, void *rusage) int = SYS_wait4
//sys _sysrawpipe2(int *fd, int flags) int = SYS_pipe2

// Tier 6 notification -- see syscall_linux_amd64.decl's identical
// comment.
//sys _syskill(int pid, int sig) int = SYS_kill
//sys _sysrtsigaction(int sig, void *act, void *oact, long sigsetsize) int = SYS_rt_sigaction

// rc self-hosting's Isatty() (os/linux/isatty.c). arg stays void*
// like _sysrtsigaction's act/oact above -- the raw layer stays free
// of struct definitions, os/linux/isatty.c is the one place that
// knows it points at a struct termios it never even reads (only
// checks the ioctl's own success/failure).
//sys _sysioctl(int fd, ulong request, void *arg) int = SYS_ioctl

// alarm() (os/linux/alarm.c). new/old stay void* like every other raw
// stub here -- the raw layer stays free of struct definitions, and
// os/linux/alarm.c declares the one itimerval shape it needs.
//sys _syssetitimer(int which, void *new, void *old) int = SYS_setitimer
