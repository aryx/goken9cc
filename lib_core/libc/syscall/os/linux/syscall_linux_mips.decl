// Declarative syscall spec for linux/mips, in the spirit of
// GO/pkg/syscall's "//sys name(args) (ret) = SYS_NAME" comments (see
// GO/pkg/syscall/syscall_linux.go), parsed by scripts/mksyscall.sh into
// zsyscall_linux_mips.c. Every wrapper just calls the one generic
// _syscall6 trampoline (lib_core/libc/syscall/os/linux/svc_mips.s), so
// adding a syscall here is the only step needed -- no new assembly
// (as long as it needs no more than 3 args -- see that file's note on
// o32's stack-passed 5th/6th syscall argument).

//sys write(int fd, void *buf, long n) long = SYS_write
//sys read(int fd, void *buf, long n) long = SYS_read
//sys close(int fd) int = SYS_close
//sys lseek(int fd, vlong offset, int whence) long = SYS_lseek
// _sysopen, not open: see syscall_linux_amd64.decl's identical comment --
// this is the raw 3-arg POSIX shape, distinct from Plan9's 2-arg
// open(char*,int) (include/os/file.h), which os/linux/open.c builds
// on top of this.
//sys _sysopen(void *path, int flags, int mode) long = SYS_open
// see syscall_linux_386.decl's identical comment: chdir needs no glue,
// while _sysunlink/_sysrmdir/_sysmkdir are raw shapes that port/remove.c
// and os/$GOOS/open.c bridge into Plan9's remove() and create().
//sys _sysunlink(char *path) int = SYS_unlink
//sys _sysrmdir(char *path) int = SYS_rmdir
//sys _sysmkdir(char *path, int mode) int = SYS_mkdir
//sys chdir(char *path) int = SYS_chdir
//sys exit(int code) void = SYS_exit
