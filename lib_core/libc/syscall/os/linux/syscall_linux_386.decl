// Declarative syscall spec for linux/386, in the spirit of
// GO/pkg/syscall's "//sys name(args) (ret) = SYS_NAME" comments (see
// GO/pkg/syscall/syscall_linux.go), parsed by scripts/mksyscall.sh into
// zsyscall_linux_386.c. Every wrapper just calls the one generic
// _syscall6 trampoline (lib_core/libc/syscall/os/linux/svc_386.s), so
// adding a syscall here is the only step needed -- no new assembly.

//sys write(int fd, void *buf, long n) long = SYS_write
//sys read(int fd, void *buf, long n) long = SYS_read
//sys close(int fd) int = SYS_close
//sys lseek(int fd, vlong offset, int whence) long = SYS_lseek
// _sysopen, not open: see syscall_linux_amd64.decl's identical comment --
// this is the raw 3-arg POSIX shape, distinct from Plan9's 2-arg
// open(char*,int) (include/os/file.h), which os/linux/open.c builds
// on top of this.
//sys _sysopen(void *path, int flags, int mode) long = SYS_open
// chdir is Plan9's own name (include/os/dir.h) for POSIX chdir(2):
// same shape, same semantics, same 0/-1 result, so it needs no
// os/$GOOS/ API-shape translation layer at all and is generated
// straight into its public symbol name.
//
// The three above it are _sys-prefixed raw shapes rather than public
// names, because the two Plan9 calls they serve do NOT line up 1:1
// with a POSIX syscall:
//  - Plan9's remove() deletes a file OR a directory, while POSIX
//    unlink(2) refuses directories -- that is what rmdir(2) is for. So
//    the public remove() is port/remove.c, a try-unlink-then-rmdir
//    bridge over _sysunlink()/_sysrmdir().
//  - Plan9's create() takes a perm word whose DMDIR bit means "make a
//    directory", so os/linux/open.c dispatches to either
//    _sysopen(O_CREAT|O_TRUNC) or _sysmkdir() on that bit. Note there
//    is still no SYS_create: only the DMDIR half needs a syscall of
//    its own.
//sys _sysunlink(char *path) int = SYS_unlink
//sys _sysrmdir(char *path) int = SYS_rmdir
//sys _sysmkdir(char *path, int mode) int = SYS_mkdir
// access: Plan9's mode bits (AEXIST/AEXEC/AWRITE/AREAD = 0/1/2/4,
// include/os/file.h) are numerically identical to POSIX's
// F_OK/X_OK/W_OK/R_OK, so like chdir this needs no translation and is
// generated straight into its public name.
//sys access(char *path, int mode) int = SYS_access
// dup is _sys-prefixed because Plan9's dup(oldfd, newfd) is ONE call
// covering what POSIX splits in two: newfd == -1 means "lowest free
// fd" (POSIX dup), anything else is dup2. port/dup.c bridges them.
//sys _sysdup(int fd) int = SYS_dup
//sys _sysdup2(int oldfd, int newfd) int = SYS_dup2
//sys chdir(char *path) int = SYS_chdir
//sys exit(int code) void = SYS_exit
// brk: the raw kernel primitive, _sys-prefixed like the others because
// its shape is NOT the public one. Linux's brk(2) returns the NEW break
// and reports failure by returning the UNCHANGED old one -- no errno at
// all -- whereas include/os/mem.h's brk() is Plan9-shaped (0/-1).
// os/linux/brk.c bridges the two, and port/sbrk.c sits on top of that.
// rettype uintptr, not long: on the 64-bit archs a `long` is only 4
// bytes here (see syscall_linux_amd64.h) and would truncate the
// returned address; uintptr is pointer-wide on every arch by
// definition, so all seven decls can say the same thing.
//sys _sysbrk(void *addr) uintptr = SYS_brk
// the "small tier": getpid, getwd, time/nsec, sleep.
// getpid is the only one generated straight into its public name -- it
// takes nothing, returns an int, and Plan9 and POSIX agree exactly.
//sys getpid(void) int = SYS_getpid
// getcwd is _sys-prefixed because the shapes differ twice over: POSIX
// returns the LENGTH written (or -errno), Plan9's getwd() returns the
// buffer (or nil). os/linux/getwd.c bridges it.
//sys _sysgetcwd(char *buf, ulong size) long = SYS_getcwd
// clock_gettime/clock_nanosleep rather than gettimeofday/nanosleep, and
// on the 32-bit arches these numbers are the *_time64 variants -- see
// numbers_$cputype.h for why (the timespec is 8+8 on every arch this
// way, so os/linux/time.c needs no per-arch layout). The timespec is
// passed as void* here for the same reason _sysopen takes void*: the
// raw layer stays free of struct definitions, and os/linux/time.c
// declares the one shape it needs.
//sys _sysclockgettime(int clockid, void *ts) int = SYS_clock_gettime
//sys _sysclocknanosleep(int clockid, int flags, void *req, void *rem) int = SYS_clock_nanosleep
// the stat family (Tier 3). buf is void* for the same reason the
// clock_* calls above are -- os/linux/stat_386.c declares the one
// struct stat64 shape it needs, the raw layer stays struct-free.
// _sysftruncate64 takes the 64-bit length pre-split into two 32-bit
// halves rather than one vlong argument: the kernel's own
// sys_ftruncate64() signature is (fd, offset_low, offset_high), not a
// single loff_t, precisely so 32-bit ABIs don't need register-pair
// alignment for it -- os/linux/stat_386.c does the splitting.
//sys _sysfstat(int fd, void *buf) int = SYS_fstat64
//sys _sysfchmod(int fd, int mode) int = SYS_fchmod
//sys _sysftruncate64(int fd, ulong lo, ulong hi) int = SYS_ftruncate64
// dirread's two raw calls (Tier 3.5). openat, not _sysopen: named to
// match arm64/riscv64's own public openat(dirfd,path,flags,mode) (this
// arch has no such call yet -- legacy SYS_open sufficed until now), so
// os/linux/stat_386.c's dirread() can call the SAME extern name on
// every Linux arch regardless of which raw syscall backs it.
//sys openat(int dirfd, void *path, int flags, int mode) long = SYS_openat
//sys _sysgetdents64(int fd, void *buf, uint count) long = SYS_getdents64
// renameat2(2) -- os/linux/dirwstat.c's dirwstat() name-change support
//sys _sysrenameat2(int olddirfd, void *oldpath, int newdirfd, void *newpath, uint flags) long = SYS_renameat2
// Tier 4 process control (docs/claude_notes/plan_syscalls.txt). All
// four are _sys-prefixed raw shapes, not public names -- unlike
// getpid/chdir/access above, fork()/exec()/wait()/pipe() each need a
// port/*.c bridge (port/fork.c, port/exec.c, port/wait.c, port/pipe.c)
// to normalize the raw negative-errno failure result into Plan9's
// exact -1 contract (see port/fork.c's own comment for why this
// specifically matters for fork, not just tidiness).
//sys _sysfork(void) int = SYS_fork
//sys _sysexecve(void *path, void *argv, void *envp) int = SYS_execve
//sys _syswait4(int pid, void *status, int options, void *rusage) int = SYS_wait4
//sys _syspipe(int *fd) int = SYS_pipe

// Tier 6 notification -- see syscall_linux_amd64.decl's identical
// comment.
//sys _syskill(int pid, int sig) int = SYS_kill
//sys _sysrtsigaction(int sig, void *act, void *oact, long sigsetsize) int = SYS_rt_sigaction

// rc self-hosting's Isatty() (os/linux/isatty.c). arg stays void*
// like _sysrtsigaction's act/oact above -- the raw layer stays free
// of struct definitions, os/linux/isatty.c is the one place that
// knows it points at a struct termios it never even reads (only
// checks the ioctl's own success/failure).
//sys _sysioctl(int fd, ulong request, void *arg) int = SYS_ioctl

// alarm() (os/linux/alarm.c). new/old stay void* like every other raw
// stub here -- the raw layer stays free of struct definitions, and
// os/linux/alarm.c declares the one itimerval shape it needs.
//sys _syssetitimer(int which, void *new, void *old) int = SYS_setitimer
