<$TOP/mkfiles/mkfile.proto

# the goken cross-toolchain itself: used by tests/ (mk objtype=riscv) and,
# once self-hosting is viable, as CC/AS/LD for the top-level build too.
# The RISC-V (rv32) lineage, ic/ia/il, object ext .i
O=i
CC=ic
LD=il
AS=ia
AR=iar

CFLAGS=$CFLAGS_COMMON -I$TOP/include/arch/riscv
