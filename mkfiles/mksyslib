# -*- sh -*-

LIB=$ROOT/arch/$objtype/lib/$LIBNAME

all:V:  $LIB

#TODO: principia: 'ar vu' under plan9, rsc is GNU binutils specific
# note: $AR, not a hardcoded 'ar' -- a goken-native build (AR=iar) needs
# its own archive format, which the host's binutils ar can't produce
# and goken's own Xl can't read the reverse of either
# claude: rm -f first, so the archive is always built from scratch.
# $prereq here is the FULL $OFILES list (not just the out-of-date ones,
# which is $newprereq), so a fresh archive is complete by construction --
# whereas ar's `r` key MERGES into whatever file is already sitting
# there. Merging is never what is wanted here and has bitten this tree
# repeatedly: a stale archive left by the original build-mk.sh bootstrap
# made iar report "ar: phase error", and after the top-level `bootstrap`
# target runs, a local archive holds the OTHER objtype's members, which
# a later build would quietly merge host .o files into.
$LIB:   $OFILES
        rm -f $LIBNAME
        $AR $ARFLAGS $LIBNAME $prereq
	cp $LIBNAME $LIB

%.$O:   $HFILES                 # don't combine with following %.$O rules

# this will work also for OFILES in subdir as fmt/chartod.o thx to '-o $target'
# note: -o must come *before* the source file: goken's own Xc/Xa (unlike
# gcc) stop scanning for flags at the first non-flag argument (standard
# Plan9 ARGBEGIN/getopt-style parsing), so a trailing '-o $target' after
# $stem.c/$stem.s would silently be read as extra input filenames instead
%.$O:   %.c
	$CC $CFLAGS $CFLAGS_EXTRA -o $target $stem.c
%.$O:   %.s
	$AS $AFLAGS -o $target $stem.s

install:V: $LIB
uninstall:V:
        rm -f $LIB

installall:V:
        for(objtype in $CPUS) 
           mk install
%.all:V:
        for(objtype in $CPUS) 
           mk $stem

clean:V:
        rm -f *.[$OS] [$OS].out $CLEANFILES *.$O $OFILES $LIBNAME
nuke:V:
        mk clean
	rm -f $LIB

%.clean:V:
        rm -f $stem.[$OS] [$OS].$stem $stem.acid $stem

%.acid: %.$O $HFILES
        $CC $CFLAGS -a $stem.c >$target
