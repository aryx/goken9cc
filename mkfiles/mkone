# -*- sh -*-

# keyed by objtype (not cputype) so a host-bootstrap build
# (objtype=boot-gcc/boot-clang) and a self-hosted build for the same
# target (objtype=arm64/amd64/...) never share a directory
BIN=$ROOT/arch/$objtype/bin

all:V:	$O.out

# claude: $BOOTLIBS appended directly here rather than via a leaf
# mkfile's own LDLIBS=$BOOTLIBS -- the latter hits a real mk quirk
# (VAR=$UNASSIGNED becomes one stray empty argument, not zero) once
# BOOTLIBS is itself unassigned for a self-hosted objtype. See
# todo.org's "self-hosting utilities/mk/rc" entry for the full story.

$O.out:	$OFILES $LIB
	$LD $LDFLAGS -o $target $prereq $LDLIBS $BOOTLIBS

%.$O:	$HFILES		# don't combine with following %.$O rules

# note: -o must come *before* the source file -- see mkfiles/mksyslib
%.$O:	%.c
	$CC $CFLAGS $CFLAGS_EXTRA -o $target $stem.c
%.$O:	%.s
	$AS $AFLAGS -o $target $stem.s

# to generate also y.tab.h with the token definitions
# alt: move that in YACC definition in mkfile.proto
YFLAGS=-d
y.tab.h y.tab.c:	$YFILES
	$YACC $YFLAGS $prereq
lex.yy.c:	$LFILES
	$LEX $LFLAGS $prereq

install:V: $BIN/$TARG
uninstall:V:
	rm -f $BIN/$TARG
$BIN/$TARG:	$O.out
	cp $prereq $target

installall:V:
	for(objtype in $CPUS)
		mk install
allall:V:
	for(objtype in $CPUS)
		mk all

clean:V:
	rm -f *.[$OS] [$OS].out y.tab.? lex.yy.c y.debug y.output $TARG $CLEANFILES $OFILES *.$O $O.out
nuke:V:
        mk clean
	rm -f *.acid $BIN/$TARG $NUKEFILES

safeinstall:V: $O.out
	test -e $BIN/$TARG && mv $BIN/$TARG $BIN/_$TARG
	cp $prereq $BIN/$TARG
safeinstallall:V:
	for (objtype in $CPUS)
		mk safeinstall

%.acid: %.$O $HFILES
	$CC $CFLAGS -a $stem.c >$target

