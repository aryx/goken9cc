# -*- sh -*-

all:V:	$LIB

#TODO: principia: 'ar vu' under plan9, rsc is GNU binutils specific
# note: $AR, not a hardcoded 'ar' -- see mkfiles/mksyslib
# claude: rm -f first, so the archive is always built from scratch.
# $prereq here is the FULL $OFILES list (not just the out-of-date ones,
# which is $newprereq), so a fresh archive is complete by construction --
# whereas ar's `r` key MERGES into whatever file is already sitting
# there. Merging is never what is wanted here and has bitten this tree
# repeatedly: a stale archive left by the original build-mk.sh bootstrap
# made iar report "ar: phase error", and after the top-level `bootstrap`
# target runs, a local archive holds the OTHER objtype's members, which
# a later build would quietly merge host .o files into.
$LIB:	$OFILES
	rm -f $LIB
	$AR $ARFLAGS $LIB $prereq

%.$O:	$HFILES		# don't combine with following %.$O rules

# note: -o must come *before* the source file -- see mkfiles/mksyslib
%.$O:	%.c
	$CC $CFLAGS $CFLAGS_EXTRA -o $target $stem.c
%.$O:	%.s
	$AS $AFLAGS -o $target $stem.s

# to generate also y.tab.h with the token definitions
YFLAGS=-d
y.tab.h y.tab.c: $YFILES
	$YACC $YFLAGS $prereq
lex.yy.c: $LFILES
	$LEX $LFLAGS $prereq

# as opposed to mksyslib, we do not install the lib under ROOT/<arch>/lib
install:VQ: $LIB
uninstall:VQ:
	echo nothing to uninstall

installall:V:
	for (objtype in $CPUS)
		mk install
%.all:V:
	for (objtype in $CPUS)
		mk $stem

clean:V:
	rm -f *.[$OS] y.tab.? y.output y.error $CLEANFILES *.$O $OFILES $LIBNAME
nuke:V:
        mk clean
        rm -f $LIB 
