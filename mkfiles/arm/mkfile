<$TOP/mkfiles/mkfile.proto

# the goken cross-toolchain itself: used by tests/ (mk objtype=arm) and,
# once self-hosting is viable, as CC/AS/LD for the top-level build too
O=5
CC=5c
LD=5l -H7
AS=5a
AR=iar

CFLAGS=$CFLAGS_COMMON -I$TOP/include/arch/arm

# arm has no hardware integer divide instruction, so 5c emits calls to
# software helpers for any C division/modulo -- see
# lib_core/libc/arch/arm/div.s (and lib_core/libc/mkfile's own
# ARCHEXTRAOFILES comment for why this is set here, not there). Also
# getcallerpc.s: lib_core/libc/port/getcallerpc.c's own #ifdef guards
# this arch out of its portable fallback, expecting the real
# implementation here instead.
ARCHEXTRAOFILES=arch/arm/div.$O arch/arm/getcallerpc.$O arch/arm/vlop.$O arch/arm/setjmp.$O
