# -*- sh -*-
# ----------------------------------------------------------------------------
# Patterns
# ----------------------------------------------------------------------------

# gcc/clang object files
*.o

# goken/kencc object files
*.[5678evijz]

# gcc and goken libs
*.a
*.ao
# claude: the same objtype-qualified intermediate archives as *.ao above
# (mkfiles/mklib's $LIB=cc.a$O and friends), for the goken objtypes --
# same letter set as the *.[5678evijz] object-file line above. Needed
# once anything is built for a non-boot objtype: the top-level
# `bootstrap` target leaves a compilers/cck/cc.a7 on an arm64 host.
*.a[5678evijz]

[5678ovijz].out
_testmain.go
o.*
a.out

# yacc files
y.tab.[ch]
y.output

# pad's syncweb
.md5sum_*

# pad's test files
*.exe
*.uexe
*.wasm
*.goken
*.goken-O0
*.goken-O3

# tex object files
*.aux
*.log
# can be also used for some tests
*.out

# yacc debugging info on grammar 
y.debug

/ROOT/arch/*/bin/

# ----------------------------------------------------------------------------
# Specific files
# ----------------------------------------------------------------------------
# generared by configure
/mkconfig

# generated by all.bash
/GO/pkg/Make.deps

# what the go compilers will generate (e.g., pkg/<arch>/runtime.a)
/pkg
# pkg/ bin/ lib/ are the main output of all.bash
/bin
/lib

/utilities/calc/misc/bc.c
/utilities/text/awk/proctab.c

# generated by make.bash
/GO/C/cmd/5l/enam.c
/GO/C/cmd/6l/enam.c
/GO/C/cmd/8l/enam.c

/linkers/7l/enam.c
/linkers/il/enam.c
/linkers/vl/enam.c
/linkers/zl/enam.c
/linkers/8lk/enam.c
/linkers/5lk/enam.c

/GO/C/cmd/6a/6ag
/GO/C/cmd/6c/6cg
/GO/C/cmd/6l/6lg
/GO/C/cmd/8a/8ag
/GO/C/cmd/8c/8cg
/GO/C/cmd/8l/8lg
/GO/C/cmd/nm/6nm
/GO/C/cmd/prof/6prof
/GO/C/cmd/cov/6cov

# generated by make.bash go-specific stuff
/GO/cmd/6g/6g
/GO/cmd/8g/8g
/GO/misc/misc/cgo/cgo
/GO/cmd/gc/builtin.c
/GO/cmd/gc/opnames.h
/GO/cmd/gc/y1.tab.c
/GO/cmd/gc/yerr.h
/GO/cmd/godefs/godefs
/GO/cmd/godoc/godoc
/GO/cmd/gofmt/gofmt
/GO/cmd/goinstall/goinstall
/GO/cmd/gopack/gopack
/GO/cmd/goyacc/goyacc

/GO/misc/src/libcgo/libcgo.so

/GO/pkg/os/signal/unix.go

/GO/pkg/runtime/amd64/asm.h
/GO/pkg/runtime/386/asm.h
/GO/pkg/runtime/goc2c
/GO/pkg/runtime/mkversion
/GO/pkg/runtime/runtime.acid.amd64
/GO/pkg/runtime/runtime.acid.386
/GO/pkg/runtime/version.go

# during make test
GO/pkg/debug/gosym/_test/
GO/pkg/exp/ogle/ogle
GO/pkg/template/_test/

GO/test/pass.out
GO/test/run.out
GO/test/times.out

# generated by pdflatex and syncweb
docs/iwp9/iwp9.pdf
docs/iwp9/iwp9.tex

# ----------------------------------------------------------------------------

# golden reference outputs for tests/s/variants (see its mkfile 'golden' target)
!tests/s/variants/expected/*
!tests/c/variants/expected/*

# generated by tests/c/variants (bigfunc_arm large-procedure link test)
tests/c/variants/bigfunc_arm.c
