TOP=../../..
<$TOP/mkfiles/$objtype/mkfile

# unlike tests/c/mini*, this one links against a real, reusable libc.a
# (lib_core/libc/), not a hand-rolled per-test stub -- so it needs that
# built and installed first:
#   cd $TOP/lib_core/libc && mk 'objtype='$cputype 'cputype='$cputype install
# linux (qemu, test_one): arm64/amd64/mips/riscv/riscv64/386/arm done.
# darwin (native, no qemu -- see test_macos_arm64/test_macos_amd64
# below): arm64 and amd64 (via Rosetta 2 on Apple Silicon) done. All
# three share this one hello.c; only the libc.a underneath and the
# link/run step differ (see lib_core/libc/mkfile's own GOOS story).

all:V: hello.exe io.exe dir.exe fd.exe mem.exe proc.exe args.exe env.exe ctime.exe atexit.exe utfmisc.exe notify.exe
# claude: dir_tmp.txt and the dir_tmp_d/ directory are created by dir.c
# and removed by it again, so they are only ever left behind if that
# test died in between -- cleaned up here rather than left to confuse
# the next run. stat_tmp.txt is stat.c's equivalent; dirread_tmp_d/ is
# dirread.c's (a directory with two files and a subdirectory).
clean:V:
	rm -f *.[5678ijv] *.exe hello_macos_arm64.exe hello_macos_amd64.exe io_macos_arm64.exe io_macos_amd64.exe dir_macos_arm64.exe dir_macos_amd64.exe fd_macos_arm64.exe fd_macos_amd64.exe mem_macos_arm64.exe mem_macos_amd64.exe proc_macos_arm64.exe proc_macos_amd64.exe args_macos_arm64.exe args_macos_amd64.exe stat_macos_arm64.exe stat_macos_amd64.exe dir_tmp.txt stat_tmp.txt
	rm -rf dir_tmp_d dirread_tmp_d
# claude: stat.exe/dirread.exe/fork.exe are deliberately NOT in all:V:
# above -- unlike every other binary here, none of the three can be
# built for every arch in $ARCHS below: riscv (rv32) has no
# lib_core/libc/os/linux/stat_riscv.c at all (see numbers_riscv.h's own
# comment -- that arch has no fstat syscall, needs statx, not yet
# implemented, and dirread() needs fstat too), so linking either there
# would fail where every other test here still succeeds. dirread.exe
# additionally has NO darwin/windows build rule at all (todo.org's own
# gap entry -- dirread() isn't implemented for either GOOS yet), unlike
# stat.exe which at least compiles there. fork.exe joins this same
# riscv-only exclusion for an unrelated reason -- numbers_riscv.h's own
# Tier 4 comment: rv32 has no wait4(2) at all (64-bit-only in
# scripts/syscall.tbl), so Tier 4 process control was deliberately left
# out entirely for that one arch, same "documented gap" treatment as
# stat's. Wired into test_one/test:V:/test_plan9 individually below
# instead, with riscv skipped in the ARCHS loop specifically.
test_one:V:
	mk 'objtype='$cputype all
	$TOP/scripts/qemu-runner $cputype ./hello.exe | cmp /dev/stdin expected.txt
	$TOP/scripts/qemu-runner $cputype ./io.exe | cmp /dev/stdin io_expected.txt
	$TOP/scripts/qemu-runner $cputype ./dir.exe | cmp /dev/stdin dir_expected.txt
	$TOP/scripts/qemu-runner $cputype ./fd.exe | cmp /dev/stdin fd_expected.txt
	$TOP/scripts/qemu-runner $cputype ./mem.exe | cmp /dev/stdin mem_expected.txt
	$TOP/scripts/qemu-runner $cputype ./proc.exe | cmp /dev/stdin proc_expected.txt
	$TOP/scripts/qemu-runner $cputype ./env.exe | cmp /dev/stdin env_expected.txt
	$TOP/scripts/qemu-runner $cputype ./args.exe one two three | cmp /dev/stdin args_expected.txt
	$TOP/scripts/qemu-runner $cputype ./ctime.exe | cmp /dev/stdin ctime_expected.txt
	$TOP/scripts/qemu-runner $cputype ./atexit.exe | cmp /dev/stdin atexit_expected.txt
	$TOP/scripts/qemu-runner $cputype ./utfmisc.exe | cmp /dev/stdin utfmisc_expected.txt
	$TOP/scripts/qemu-runner $cputype ./notify.exe | cmp /dev/stdin notify_expected.txt
	if(! ~ $cputype riscv){
		mk 'objtype='$cputype stat.exe dirread.exe fork.exe
		$TOP/scripts/qemu-runner $cputype ./stat.exe | cmp /dev/stdin stat_expected.txt
		$TOP/scripts/qemu-runner $cputype ./dirread.exe | cmp /dev/stdin dirread_expected.txt
		$TOP/scripts/qemu-runner $cputype ./fork.exe | cmp /dev/stdin fork_expected.txt
	}

# unlike tests/c/mini2's own ARCHS loop (a self-contained per-test stub,
# no external library), each arch here also needs lib_core/libc's real
# libc.a freshly rebuilt+installed first -- same 'rm -f libc.a; mk -a
# ... install' dance test_macos_arm64/test_macos_amd64 below already do,
# for the same reason (see lib_core/libc/mkfile's mksyslib comment on
# why a stale/mixed-arch libc.a corrupts otherwise, and this mkfile's
# own header comment above). Driven from the top-level `mk test` via
# tests/c/mkfile's DIRS and mkfiles/mkdirs' generic recursion -- no
# per-arch objtype/cputype needs to be passed in from outside, unlike
# test_one, which expects the caller to have already picked one.
ARCHS=386 amd64 arm arm64 mips riscv riscv64
test:V:
	for (arch in $ARCHS) {
		echo $arch
		mk clean
		@{ cd $TOP/lib_core/libc; rm -f libc.a; mk -a 'objtype='$arch 'cputype='$arch install }
		mk 'objtype='$arch 'cputype='$arch all
		$TOP/scripts/qemu-runner $arch ./hello.exe | cmp /dev/stdin expected.txt
		$TOP/scripts/qemu-runner $arch ./io.exe | cmp /dev/stdin io_expected.txt
		$TOP/scripts/qemu-runner $arch ./dir.exe | cmp /dev/stdin dir_expected.txt
		$TOP/scripts/qemu-runner $arch ./fd.exe | cmp /dev/stdin fd_expected.txt
		$TOP/scripts/qemu-runner $arch ./mem.exe | cmp /dev/stdin mem_expected.txt
		$TOP/scripts/qemu-runner $arch ./proc.exe | cmp /dev/stdin proc_expected.txt
		$TOP/scripts/qemu-runner $arch ./env.exe | cmp /dev/stdin env_expected.txt
		$TOP/scripts/qemu-runner $arch ./args.exe one two three | cmp /dev/stdin args_expected.txt
		$TOP/scripts/qemu-runner $arch ./ctime.exe | cmp /dev/stdin ctime_expected.txt
		$TOP/scripts/qemu-runner $arch ./atexit.exe | cmp /dev/stdin atexit_expected.txt
		$TOP/scripts/qemu-runner $arch ./utfmisc.exe | cmp /dev/stdin utfmisc_expected.txt
		$TOP/scripts/qemu-runner $arch ./notify.exe | cmp /dev/stdin notify_expected.txt
		if(! ~ $arch riscv){
			mk 'objtype='$arch 'cputype='$arch stat.exe dirread.exe fork.exe
			$TOP/scripts/qemu-runner $arch ./stat.exe | cmp /dev/stdin stat_expected.txt
			$TOP/scripts/qemu-runner $arch ./dirread.exe | cmp /dev/stdin dirread_expected.txt
			$TOP/scripts/qemu-runner $arch ./fork.exe | cmp /dev/stdin fork_expected.txt
		}
	}
	mk test_plan9

# claude: Plan9 (GOOS=plan9), run under machines/5i and machines/vi
# instead of qemu -- see lib_core/libc/mkfile's own GOOS story and
# docs/claude_notes/notes_abi_plan9.txt for how this GOOS came up. Only
# arm/mips: those are the only two archs with a working Plan9 emulator
# in this tree (see tests/s/mini/mkfile's own PLAN9BINS/
# hello_plan9_386.exe comment -- 8l can produce a -H2 386 binary but
# there's no emulator to run it on here). Same rebuild-libc.a-fresh
# dance as the ARCHS loop above, but with 'GOOS=plan9' added, and
# 5c/5l/vc/vl invoked directly (not via $CC/$LD/$LDFLAGS, which are
# this mkfile's own $objtype's tools -- wrong arch/GOOS here) the same
# way tests/s/mini/mkfile already does for its own hand-written Plan9
# .s tests. A separate target (called from test:V: above, but also
# runnable on its own) so the Plan9 side can be iterated on without
# waiting for the full 7-arch qemu ARCHS loop.
test_plan9:V:
	mk clean
	@{ cd $TOP/lib_core/libc; rm -f libc.a; mk -a 'objtype=arm' 'cputype=arm' 'GOOS=plan9' install }
	mk 'objtype=arm' hello_plan9_arm.exe io_plan9_arm.exe dir_plan9_arm.exe fd_plan9_arm.exe mem_plan9_arm.exe proc_plan9_arm.exe env_plan9_arm.exe args_plan9_arm.exe stat_plan9_arm.exe dirread_plan9_arm.exe ctime_plan9_arm.exe atexit_plan9_arm.exe utfmisc_plan9_arm.exe fork_plan9_arm.exe pipe_plan9_arm.exe
	printf ':c\n$q\n' | 5i ./hello_plan9_arm.exe | sed -n 2p | cmp /dev/stdin expected.txt
	printf ':c\n$q\n' | 5i ./io_plan9_arm.exe | sed -n 2,4p | cmp /dev/stdin io_expected.txt
	printf ':c\n$q\n' | 5i ./dir_plan9_arm.exe | sed -n 2,5p | cmp /dev/stdin dir_expected.txt
	printf ':c\n$q\n' | 5i ./fd_plan9_arm.exe | sed -n 2,4p | cmp /dev/stdin fd_expected.txt
	printf ':c\n$q\n' | 5i ./mem_plan9_arm.exe | sed -n 2p | cmp /dev/stdin mem_expected.txt
	printf ':c\n$q\n' | 5i ./args_plan9_arm.exe one two three | sed -n 2,5p | cmp /dev/stdin args_expected.txt
	printf ':c\n$q\n' | 5i ./ctime_plan9_arm.exe | sed -n 2p | cmp /dev/stdin ctime_expected.txt
	printf ':c\n$q\n' | 5i ./utfmisc_plan9_arm.exe | sed -n 2p | cmp /dev/stdin utfmisc_expected.txt
	printf ':c\n$q\n' | 5i ./pipe_plan9_arm.exe | sed -n 2,3p | cmp /dev/stdin pipe_expected.txt
	mk clean
	@{ cd $TOP/lib_core/libc; rm -f libc.a; mk -a 'objtype=mips' 'cputype=mips' 'GOOS=plan9' install }
	mk 'objtype=mips' hello_plan9_mips.exe io_plan9_mips.exe dir_plan9_mips.exe fd_plan9_mips.exe mem_plan9_mips.exe proc_plan9_mips.exe env_plan9_mips.exe args_plan9_mips.exe stat_plan9_mips.exe dirread_plan9_mips.exe ctime_plan9_mips.exe atexit_plan9_mips.exe utfmisc_plan9_mips.exe fork_plan9_mips.exe pipe_plan9_mips.exe
	printf ':c\n$q\n' | vi ./hello_plan9_mips.exe | sed -n 2p | cmp /dev/stdin expected.txt
	printf ':c\n$q\n' | vi ./io_plan9_mips.exe | sed -n 2,4p | cmp /dev/stdin io_expected.txt
	printf ':c\n$q\n' | vi ./dir_plan9_mips.exe | sed -n 2,5p | cmp /dev/stdin dir_expected.txt
	printf ':c\n$q\n' | vi ./fd_plan9_mips.exe | sed -n 2,4p | cmp /dev/stdin fd_expected.txt
	printf ':c\n$q\n' | vi ./mem_plan9_mips.exe | sed -n 2p | cmp /dev/stdin mem_expected.txt
	printf ':c\n$q\n' | vi ./args_plan9_mips.exe one two three | sed -n 2,5p | cmp /dev/stdin args_expected.txt
	printf ':c\n$q\n' | vi ./ctime_plan9_mips.exe | sed -n 2p | cmp /dev/stdin ctime_expected.txt
	printf ':c\n$q\n' | vi ./utfmisc_plan9_mips.exe | sed -n 2p | cmp /dev/stdin utfmisc_expected.txt
	printf ':c\n$q\n' | vi ./pipe_plan9_mips.exe | sed -n 2,3p | cmp /dev/stdin pipe_expected.txt

# -H7 (ELF) is explicit, not left to 6l/7l/8l's own default: those
# three (unlike vl/il/jl, which always default to ELF regardless of
# host) fall back to *the host's own compiled-in GOOS* when no -H is
# given (linkers/{6,7,8}l/obj.c's HEADTYPE==-1 case) -- so this exact
# recipe, run on a Darwin host, would otherwise silently produce a
# Mach-O (6l/7l) or Plan 9 (8l, via 5l's own unconditional H_PLAN9
# default -- arm has no host-GOOS detection at all) binary instead of
# the ELF qemu-runner/test_one need. Caught by actually trying to link
# amd64's hello.exe on this Darwin host without it: it built a Mach-O
# whose non-PIE-safe 6c-compiled code then failed inside 6l with
# "doasm: notfound" on an absolute-address CMPQ -- see
# docs/claude_notes/notes_libc_selfhost.txt for the full story, and
# tests/s/mini/mkfile for the same -H7-is-not-optional lesson already
# applied there.
hello.exe: hello.c
	$CC $CFLAGS -D$objtype -c hello.c
	$LD $LDFLAGS -H7 -o $target -E _main hello.$O -lc

# args.c: argc/argv, passed as literal "one two three" by every caller
# above -- see arch/$cputype/rt0.s's own argc/argv-bridge comment and
# docs/claude_notes/notes_debug_techniques.txt's "Cross-arch rt0.s
# bring-up" section for the bug this guards against. Same -H7/-D$objtype
# story as hello.exe above.
args.exe: args.c
	$CC $CFLAGS -D$objtype -c args.c
	$LD $LDFLAGS -H7 -o $target -E _main args.$O -lc

# io.c: open/read/seek/write/close on a real file, not just stdout --
# see io.c's own comment. Same -H7/-D$objtype story as hello.exe above.
io.exe: io.c
	$CC $CFLAGS -D$objtype -c io.c
	$LD $LDFLAGS -H7 -o $target -E _main io.$O -lc

# claude: dir.c: create/remove/chdir -- the file-system-MODIFYING calls,
# as opposed to io.c's read-only ones. See dir.c's own comment. Same
# -H7/-D$objtype story as hello.exe above.
dir.exe: dir.c
	$CC $CFLAGS -D$objtype -c dir.c
	$LD $LDFLAGS -H7 -o $target -E _main dir.$O -lc

# claude: fd.c: access/dup. NOT built for windows -- see fd.c's own
# comment and os/windows/open.c's access() for why dup() cannot be
# implemented there yet.
fd.exe: fd.c
	$CC $CFLAGS -D$objtype -c fd.c
	$LD $LDFLAGS -H7 -o $target -E _main fd.$O -lc

# claude: mem.c: sbrk. Built for every GOOS including windows -- unlike
# fd.c, nothing here depends on the fd-as-truncated-HANDLE
# simplification. Same -H7/-D$objtype story as hello.exe above.
mem.exe: mem.c
	$CC $CFLAGS -D$objtype -c mem.c
	$LD $LDFLAGS -H7 -o $target -E _main mem.$O -lc

# claude: proc.c: getpid/getwd/time/nsec/sleep. Built for every GOOS --
# each implements these very differently (syscall, file read, or a
# kernel32 call), which is much of the point of the test.
proc.exe: proc.c
	$CC $CFLAGS -D$objtype -c proc.c
	$LD $LDFLAGS -H7 -o $target -E _main proc.$O -lc

# claude: env.c: getenv. On linux/darwin this needs no syscall at all --
# the environment is stack memory past argv's nil, reached via the argv
# rt0.s stashes (port/mainargs.c, port/getenv.c). Built for every GOOS.
env.exe: env.c
	$CC $CFLAGS -D$objtype -c env.c
	$LD $LDFLAGS -H7 -o $target -E _main env.$O -lc

# claude: ctime.c: gmtime/localtime/asctime/ctime/tm2sec. Pure calendar
# arithmetic plus one best-effort open() of a Plan9-shaped
# "/env/timezone" (port/ctime.c's/tm2sec.c's own comment) -- no syscall
# this GOOS lacks, so unlike stat.exe/dirread.exe this builds AND runs
# for every $cputype including riscv, and is expected to actually pass
# under plan9's 5i/vi too (see test_plan9 below), not just link.
ctime.exe: ctime.c
	$CC $CFLAGS -D$objtype -c ctime.c
	$LD $LDFLAGS -H7 -o $target -E _main ctime.$O -lc

# claude: atexit.c: atexit()/exits()'s atexitrun() hook (port/atexit.c,
# port/exits.c). Portable everywhere exits() itself is (every GOOS
# except plan9's own raw EXITS syscall -- see port/exits.c's comment),
# same -H7/-D$objtype story as hello.exe above.
atexit.exe: atexit.c
	$CC $CFLAGS -D$objtype -c atexit.c
	$LD $LDFLAGS -H7 -o $target -E _main atexit.$O -lc

# claude: utfmisc.c: strrchr()/strncpy()/utfrrune()/dirmodefmt() -- the
# small ls.c gaps found alongside atexit.c above. Same -H7/-D$objtype
# story as hello.exe above.
utfmisc.exe: utfmisc.c
	$CC $CFLAGS -D$objtype -c utfmisc.c
	$LD $LDFLAGS -H7 -o $target -E _main utfmisc.$O -lc

# claude: notify.c: atnotify()/postnote()/noted() (Tier 6). Same
# -H7/-D$objtype story as hello.exe above. Builds and passes for every
# arch including riscv (unlike stat/dirread/fork below), since kill()/
# rt_sigaction() need no riscv32 carve-out at all -- see
# numbers_riscv.h's own comment.
notify.exe: notify.c
	$CC $CFLAGS -D$objtype -c notify.c
	$LD $LDFLAGS -H7 -o $target -E _main notify.$O -lc

# claude: stat.c: dirstat/dirfstat/dirwstat/dirfwstat (Tier 3). NOT
# built for every $cputype -- see all:V:'s own comment on why riscv is
# excluded. Same -H7/-D$objtype story as hello.exe above.
stat.exe: stat.c
	$CC $CFLAGS -D$objtype -c stat.c
	$LD $LDFLAGS -H7 -o $target -E _main stat.$O -lc

# claude: dirread.c: dirread/dirreadall (Tier 3.5). NOT built for every
# $cputype, and no darwin/windows rule at all -- see all:V:'s own
# comment. Same -H7/-D$objtype story as hello.exe above.
dirread.exe: dirread.c
	$CC $CFLAGS -D$objtype -c dirread.c
	$LD $LDFLAGS -H7 -o $target -E _main dirread.$O -lc

# claude: fork.c: fork/exec/wait/pipe (Tier 4 process control). NOT
# built for every $cputype -- see all:V:'s own comment on why riscv is
# excluded (a different reason than stat.exe's: no wait4 on rv32, not
# no fstat). No darwin/windows/plan9 rule either: Tier 4 is linux-only
# so far (lib_core/libc/mkfile's own PROCOFILES comment). Same
# -H7/-D$objtype story as hello.exe above.
fork.exe: fork.c
	$CC $CFLAGS -D$objtype -c fork.c
	$LD $LDFLAGS -H7 -o $target -E _main fork.$O -lc

# claude: Plan9 (GOOS=plan9)/arm+mips, run under 5i/vi -- see the
# test:V: rule's own comment above for why 5c/5l/vc/vl are invoked
# directly here instead of via $CC/$LD (this mkfile's own $objtype's
# tools, wrong arch/GOOS) -H 2 is not optional the same way -H7 isn't
# for hello.exe/io.exe above (vl in particular always defaults to ELF,
# not Plan9, regardless of host -- see that comment).
hello_plan9_arm.exe: hello.c
	5c $CFLAGS_COMMON -I$TOP/include/arch/arm -Darm -Dplan9 -o hello_plan9_arm.5 -c hello.c
	5l -L$ROOT/arch/arm/lib -H 2 -o $target -E _main hello_plan9_arm.5 -lc

io_plan9_arm.exe: io.c
	5c $CFLAGS_COMMON -I$TOP/include/arch/arm -Darm -Dplan9 -o io_plan9_arm.5 -c io.c
	5l -L$ROOT/arch/arm/lib -H 2 -o $target -E _main io_plan9_arm.5 -lc

# claude: args.c on Plan9/arm -- verified this needs no rt0_plan9.s the
# way darwin/arm64 needed a rt0_darwin.s: machines/5i's own initstk()
# (5i.c) lays out argc/argv on the emulated process's initial stack in
# the same shape a raw Linux ELF entry does (argc word, then argv[]
# pointers, then a nil), so arch/arm/rt0.s's linux-derived bridge reads
# it correctly here too -- confirmed by actually running this exact
# target under 5i with real arguments, not assumed from the shape
# matching on paper.
args_plan9_arm.exe: args.c
	5c $CFLAGS_COMMON -I$TOP/include/arch/arm -Darm -Dplan9 -o args_plan9_arm.5 -c args.c
	5l -L$ROOT/arch/arm/lib -H 2 -o $target -E _main args_plan9_arm.5 -lc

hello_plan9_mips.exe: hello.c
	vc $CFLAGS_COMMON -I$TOP/include/arch/mips -Dmips -Dplan9 -o hello_plan9_mips.v -c hello.c
	vl -L$ROOT/arch/mips/lib -H 2 -o $target -E _main hello_plan9_mips.v -lc

io_plan9_mips.exe: io.c
	vc $CFLAGS_COMMON -I$TOP/include/arch/mips -Dmips -Dplan9 -o io_plan9_mips.v -c io.c
	vl -L$ROOT/arch/mips/lib -H 2 -o $target -E _main io_plan9_mips.v -lc

# claude: args.c on Plan9/mips -- see args_plan9_arm.exe's comment;
# same verification done here via machines/vi.
args_plan9_mips.exe: args.c
	vc $CFLAGS_COMMON -I$TOP/include/arch/mips -Dmips -Dplan9 -o args_plan9_mips.v -c args.c
	vl -L$ROOT/arch/mips/lib -H 2 -o $target -E _main args_plan9_mips.v -lc

# claude: dir.c under 5i/vi. Unlike every other GOOS, these three calls
# are plain kernel syscalls here (syscall/os/plan9/svc_$cputype.s), and
# 5i/vi already implement CREATE/REMOVE/CHDIR (machines/5i/syscall_posix.c's
# syscreate/sysremove/syschdir) by forwarding to the host -- so this
# target needed no emulator work.
dir_plan9_arm.exe: dir.c
	5c $CFLAGS_COMMON -I$TOP/include/arch/arm -Darm -Dplan9 -o dir_plan9_arm.5 -c dir.c
	5l -L$ROOT/arch/arm/lib -H 2 -o $target -E _main dir_plan9_arm.5 -lc

dir_plan9_mips.exe: dir.c
	vc $CFLAGS_COMMON -I$TOP/include/arch/mips -Dmips -Dplan9 -o dir_plan9_mips.v -c dir.c
	vl -L$ROOT/arch/mips/lib -H 2 -o $target -E _main dir_plan9_mips.v -lc

fd_plan9_arm.exe: fd.c
	5c $CFLAGS_COMMON -I$TOP/include/arch/arm -Darm -Dplan9 -o fd_plan9_arm.5 -c fd.c
	5l -L$ROOT/arch/arm/lib -H 2 -o $target -E _main fd_plan9_arm.5 -lc

fd_plan9_mips.exe: fd.c
	vc $CFLAGS_COMMON -I$TOP/include/arch/mips -Dmips -Dplan9 -o fd_plan9_mips.v -c fd.c
	vl -L$ROOT/arch/mips/lib -H 2 -o $target -E _main fd_plan9_mips.v -lc

# claude: mem.c under 5i/vi. brk is a plain kernel syscall on this GOOS
# (syscall/os/plan9/svc_$cputype.s, BRK=5) and both emulators already
# implement it (machines/5i/syscall.c's sysbrk, machines/vi/syscall.c's
# sysbrk_), so this needed no machines/ work -- same as dir.c's.
mem_plan9_arm.exe: mem.c
	5c $CFLAGS_COMMON -I$TOP/include/arch/arm -Darm -Dplan9 -o mem_plan9_arm.5 -c mem.c
	5l -L$ROOT/arch/arm/lib -H 2 -o $target -E _main mem_plan9_arm.5 -lc

mem_plan9_mips.exe: mem.c
	vc $CFLAGS_COMMON -I$TOP/include/arch/mips -Dmips -Dplan9 -o mem_plan9_mips.v -c mem.c
	vl -L$ROOT/arch/mips/lib -H 2 -o $target -E _main mem_plan9_mips.v -lc

# claude: proc.c IS built for plan9 (both rules below, and they link
# fine), but is deliberately NOT run under 5i/vi in test_plan9 above.
# getpid() and nsec() are file reads on this GOOS -- "#c/pid" and
# "/dev/bintime" -- which is correct for real Plan9 and is what
# principia does, but 5i/vi forward open() straight to the host
# (machines/5i/syscall_posix.c's sysopen), and a Linux host has neither
# file. So getpid() returns 0 and nsec() returns 0 there, and proc.c's
# first check fails. getwd() and sleep() DO work under the emulators
# (FD2PATH and SLEEP are both implemented in machines/{5i,vi}).
# Making the whole test runnable needs the emulators to synthesize those
# two device files -- see todo.org. Kept buildable so the plan9 code
# path at least stays compiled and linked by every run.
