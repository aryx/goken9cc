	./io_macos_amd64.exe | cmp /dev/stdin io_expected.txt
	./dir_macos_amd64.exe | cmp /dev/stdin dir_expected.txt
	./fd_macos_amd64.exe | cmp /dev/stdin fd_expected.txt
	./mem_macos_amd64.exe | cmp /dev/stdin mem_expected.txt
	./stat_macos_amd64.exe | cmp /dev/stdin stat_expected.txt
	./ctime_macos_amd64.exe | cmp /dev/stdin ctime_expected.txt
