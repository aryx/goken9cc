# claude: pipe.c on windows (Tier 4 process control, docs/claude_notes/
# plan_syscalls.txt) -- CreatePipe is a real, faithful Win32 primitive
# with no design compromise needed (unlike exec(), see os/windows/
# exec.c's own comment), and pipe.c's same-process write-then-read
# loopback (no fork() needed -- see that file's own header comment,
# written with plan9/5i-vi in mind but equally true here) needs nothing
# exec()-shaped to exercise, so this is wired into the actual run-and-
# assert list above rather than left build-only. fork.exe is
# deliberately NOT added anywhere in this windows target: it calls
# fork(), which does not exist as a symbol on this GOOS at all (see
# lib_core/libc/mkfile's PROCOFILES comment) -- linking it would fail,
# correctly.
pipe_windows_amd64.exe: pipe.c
	$CC $CFLAGS -Damd64 -Dwindows -c pipe.c
	$LD $LDFLAGS -H 10 -o $target -E _main pipe.6 -lc

