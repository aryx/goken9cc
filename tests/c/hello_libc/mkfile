# macOS-native (no qemu -- Mach-O only runs on real macOS, see
# tests/s/mini/mkfile's test_macos_arm64 for the same pattern): first
# rebuild+reinstall the darwin/arm64 libc.a lib_core/libc/mkfile
# produces (that GOOS-qualified libc.a shares its install path with
# linux/arm64's -- see that mkfile's own comment -- so this always
# rebuilds it fresh rather than risk linking against a stale one built
# for the other GOOS), then link with -H6 and codesign (mandatory on
# arm64 macOS: the kernel SIGKILLs unsigned/non-PIE/static executables
# at exec() time, see docs/claude_notes/notes_exec_macho.txt). The
# explicit 'rm -f libc.a' plus 'mk -a' (force, ignore timestamps)
# guards against a real mksyslib footgun found while testing this:
# `$AR rc $LIBNAME` merges into whatever local libc.a intermediate
# archive is already sitting in lib_core/libc/ rather than starting
# fresh, so a leftover archive from a different cputype/GOOS
# combination (anyone who just ran the linux/arm64 build, say) makes
# iar choke with "inconsistent object file" -- and since $OFILES
# themselves don't change between a linux and a darwin build, a plain
# (non-forced) 'mk install' considers the already-installed (possibly
# corrupt-from-the-above, or simply wrong-GOOS) $LIB up to date and
# skips rebuilding it entirely, silently linking hello.exe against
# stale bits. See docs/claude_notes/notes_libc_selfhost.txt.
test_macos_arm64:V:
	@{ cd $TOP/lib_core/libc; rm -f libc.a; mk -a 'objtype=arm64' 'cputype=arm64' 'GOOS=darwin' 'RT0OFILE=arch/arm64/rt0_darwin.7' install }
	mk -a 'objtype=arm64' hello_macos_arm64.exe io_macos_arm64.exe dir_macos_arm64.exe fd_macos_arm64.exe mem_macos_arm64.exe args_macos_arm64.exe stat_macos_arm64.exe ctime_macos_arm64.exe atexit_macos_arm64.exe utfmisc_macos_arm64.exe fork_macos_arm64.exe
	./hello_macos_arm64.exe | cmp /dev/stdin expected.txt
	./io_macos_arm64.exe | cmp /dev/stdin io_expected.txt
	./dir_macos_arm64.exe | cmp /dev/stdin dir_expected.txt
	./fd_macos_arm64.exe | cmp /dev/stdin fd_expected.txt
	./mem_macos_arm64.exe | cmp /dev/stdin mem_expected.txt
	./args_macos_arm64.exe one two three | cmp /dev/stdin args_expected.txt
	./stat_macos_arm64.exe | cmp /dev/stdin stat_expected.txt
	./ctime_macos_arm64.exe | cmp /dev/stdin ctime_expected.txt
	./atexit_macos_arm64.exe | cmp /dev/stdin atexit_expected.txt
	./utfmisc_macos_arm64.exe | cmp /dev/stdin utfmisc_expected.txt
	./fork_macos_arm64.exe | cmp /dev/stdin fork_expected.txt

