# macOS/amd64: same story as arm64 above, plus one extra wrinkle 6c
# needs that 7c doesn't. 6l -H6 always produces a PIE image, but plain
# 6c happily folds a symbol's address into an instruction as an
# absolute immediate (e.g. `$fmtalloc<17>+1032(SB)` as a CMPQ operand)
# -- fine for non-PIE ELF, but 6l can't encode that against a Mach-O
# PIE target ("doasm: notfound"), the same failure this mkfile's
# hello.exe rule ran into before it got its own explicit -H7 above.
# `-z` (see tests/c/mini2/mkfile's identical use, and
# docs/claude_notes/notes_exec_macho.txt) makes 6c materialize such
# addresses into a register instead, the way 7c already has no choice
# but to do on arm64. Crucially, `-z` has to apply to *libc.a's own*
# compile too, not just hello.c's: fmtalloc lives in fmt/fmt.c, one of
# libc.a's own object files, so passing `-z` only to hello.c's compile
# still failed with the exact same "doasm: notfound" until
# lib_core/libc/mkfile's own already-existing CFLAGS_EXTRA extension
# point (see its own comment) was used to flow `-z` into every one of
# libc.a's compiles too, via 'CFLAGS_EXTRA=-z' on the install line
# below. Second wrinkle: arch/amd64/rt0.s's _main assumes argc/argv
# arrive already laid out on the stack the way a raw Linux ELF entry
# provides them -- true for linux/amd64, but dyld's LC_MAIN convention
# on amd64 hands them over in registers (RDI/RSI) instead, so plain
# rt0.s would misread garbage as argc there. hello.c's own main()
# takes no parameters, so it wouldn't actually be affected either way
# -- this is here for consistency with fib.c (benchs/compcert/mkfile's
# test_goken_macos_amd64), which does read argc/argv and crashed
# without it. 'RT0OFILE=...' below selects arch/amd64/rt0_darwin.s,
# lib_core/libc/mkfile's GOOS-specific override for exactly this (see
# that file's own RT0OFILE comment for the full story). Ad-hoc signing
# is not strictly mandatory on amd64 (unlike arm64 -- XNU still runs
# unsigned amd64 binaries), but scripts/macos-codesign is harmless to
# call anyway and keeps this recipe symmetric with arm64's. Runs on
# Apple Silicon via Rosetta 2 (a native x86_64 Mac would need no such
# translation) as well as real Intel Macs.
test_macos_amd64:V:
	@{ cd $TOP/lib_core/libc; rm -f libc.a; mk -a 'objtype=amd64' 'cputype=amd64' 'GOOS=darwin' 'CFLAGS_EXTRA=-z' 'RT0OFILE=arch/amd64/rt0_darwin.6' install }
	mk -a 'objtype=amd64' hello_macos_amd64.exe io_macos_amd64.exe dir_macos_amd64.exe fd_macos_amd64.exe mem_macos_amd64.exe stat_macos_amd64.exe ctime_macos_amd64.exe atexit_macos_amd64.exe utfmisc_macos_amd64.exe fork_macos_amd64.exe
