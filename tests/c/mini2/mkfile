TOP=../../..
<$TOP/mkfiles/$objtype/mkfile

all:V: helloprintf.exe
clean:V:
	rm -f *.[5678ijv] *.exe *.a
test_one:V:
	mk 'objtype='$cputype all
	./helloprintf.exe | cmp /dev/stdin helloprintf.expected.txt

#config: add -DDEBUG if needed
CPP_FLAGS=-D$objtype

#config: can also add -v for verbose mode to help debug
helloprintf.exe: helloprintf.c
   $CC $CPP_FLAGS -c test.c
   $CC $CPP_FLAGS -c print_nofloat_no64.c
   $CC $CPP_FLAGS -c helloprintf.c
   $AS $CPP_FLAGS -c linux_$objtype.s
   $AR rc libprint.a linux_$objtype.$O print*.$O test.$O
   $LD -L. -o $target -E _main helloprintf.$O

ARCHS=386 amd64 arm arm64 mips riscv riscv64
test:V:
        for (arch in $ARCHS) {
           echo $arch
           mk clean
           mk 'objtype='$arch
           $TOP/scripts/qemu-runner $arch ./helloprintf.exe | cmp /dev/stdin helloprintf.expected.txt
        }


# macOS arm64: Darwin syscall stubs, Mach-O (-H6), mandatory ad-hoc
# signature (see docs/notes_macos.txt). Runs natively on Apple Silicon.
helloprintf_macos_arm64.exe: helloprintf.c
   7c -Darm64 -c test.c
   7c -Darm64 -c print_nofloat_no64.c
   7c -Darm64 -c helloprintf.c
   7a -Darm64 -c macos_arm64.s
   iar rc libprint.a macos_arm64.7 print*.7 test.7
   7l -H6 -L. -o $target -E _main helloprintf.7
   if(~ `{uname} Darwin) codesign -s - -f $target
   if not true

# 7c code generation regression test (see comments in regress7c.c);
# reuses the print/stub objects built by the helloprintf rule above
regress7c_macos_arm64.exe: regress7c.c helloprintf_macos_arm64.exe
   7c -Darm64 -c regress7c.c
   7l -H6 -L. -o $target -E _main regress7c.7
   if(~ `{uname} Darwin) codesign -s - -f $target
   if not true

# runs natively on Apple Silicon (no qemu needed)
test_macos_arm64:V: helloprintf_macos_arm64.exe regress7c_macos_arm64.exe
	./helloprintf_macos_arm64.exe | cmp /dev/stdin helloprintf.expected.txt
	./regress7c_macos_arm64.exe


# macOS amd64: Darwin syscall stubs (BSD syscall numbers OR'd with the
# 0x2000000 Unix class bit), Mach-O (-H6). 6l -H6 is always PIE, so 6c
# needs -z (position-independent code: no absolute $sym(SB) immediates in
# arithmetic, e.g. "(char*)buf + i") and 6l needs the RIP-relative fix in
# linkers/6l/span.c; see docs/notes_macos.txt. Runs natively on Intel Macs.
# TODO? install darling to run macos binaries from Linux
helloprintf_macos_amd64.exe: helloprintf.c
   6c -z -Damd64 -c test.c
   6c -z -Damd64 -c print_nofloat_no64.c
   6c -z -Damd64 -c helloprintf.c
   6a -Damd64 -c macos_amd64.s
   iar rc libprint.a macos_amd64.6 print*.6 test.6
   6l -s -H6 -L. -o $target -E _main helloprintf.6
   if(~ `{uname} Darwin) codesign -s - -f $target
   if not true

# 6c code generation regression test (reuses the print/stub objects
# built by the helloprintf rule above); same regress7c.c as arm64
regress7c_macos_amd64.exe: regress7c.c helloprintf_macos_amd64.exe
   6c -z -Damd64 -c regress7c.c
   6l -s -H6 -L. -o $target -E _main regress7c.6
   if(~ `{uname} Darwin) codesign -s - -f $target
   if not true

# runs natively on Intel Macs (no qemu needed)
test_macos_amd64:V: helloprintf_macos_amd64.exe regress7c_macos_amd64.exe
	./helloprintf_macos_amd64.exe | cmp /dev/stdin helloprintf.expected.txt
	./regress7c_macos_amd64.exe


# wasm regression test for compilers/ec's control flow (if/else,
# while, for, do-while -- see docs/notes_wasm.txt and regress_wasm.c's
# own comment). ec still has no *variadic* runtime (no real printf --
# see hellowrite_wasm.c's own comment on why), so unlike every recipe
# above this is verified by calling runtests() directly and checking
# its return value (scripts/wasm-call-runner.js), not by comparing
# captured stdout against an expected.txt.
regress_wasm.wasm: regress_wasm.c
   ec -o regress_wasm.e regress_wasm.c
   el -o $target regress_wasm.e

# real, running hello-world for wasm -- like every helloprintf.exe
# recipe above, a C program's actual stdout compared against
# expected.txt via cmp, just not literally calling printf() yet (see
# hellowrite_wasm.c's own comment for the real blocker: variadic
# printf needs address-taken locals, which needs the shadow-stack
# redesign docs/notes_wasm.txt still lists as a TODO). wasi_wasm.s is
# this arch's counterpart of linux_amd64.s/macos_amd64.s/
# windows_amd64.s: write()/_start, adapted to WASI instead of a real
# OS's syscall ABI -- see its own comment.
hellowrite_wasm.wasm: hellowrite_wasm.c wasi_wasm.s
   ec -o hellowrite_wasm.e hellowrite_wasm.c
   ea wasi_wasm.s
   el -o $target -I 'fd_write=wasi_snapshot_preview1.fd_write' hellowrite_wasm.e wasi_wasm.e

# real, running printf() for wasm: helloprintf_wasm.c + the shared
# print_nofloat_no64.c (unmodified) linked together via wasi_wasm.s,
# the same "actual stdout vs expected.txt" check as every helloprintf.exe
# recipe above. Needed both gaps docs/notes_wasm.txt's "Open questions"
# used to list for this to link and run correctly: ec's gextern()
# (compilers/ec/swt.c) emitting real ADATA for initialized global/static
# data (print_nofloat_no64.c's `static int32 fd = 1;` and `static int8
# *dig = "..."`), and el (linkers/el/obj.c) scoping D_STATIC symbols
# per input file so print_nofloat_no64.c's own `.string` blob doesn't
# collide with helloprintf_wasm.c's. Not the full helloprintf.c: see
# helloprintf_wasm.c's own comment for why (test.c needs uint64/float64
# and exit(), neither wired up for wasm yet).
helloprintf_wasm.wasm: helloprintf_wasm.c print_nofloat_no64.c wasi_wasm.s
   ec -o helloprintf_wasm.e helloprintf_wasm.c
   ec -o print_nofloat_no64.e print_nofloat_no64.c
   ea wasi_wasm.s
   el -o $target -I 'fd_write=wasi_snapshot_preview1.fd_write' helloprintf_wasm.e print_nofloat_no64.e wasi_wasm.e

test_wasm:V: regress_wasm.wasm hellowrite_wasm.wasm helloprintf_wasm.wasm
	node $TOP/scripts/wasm-call-runner.js regress_wasm.wasm runtests
	node $TOP/scripts/wasm-runner.js hellowrite_wasm.wasm | cmp /dev/stdin hellowrite_wasm.expected.txt
	node $TOP/scripts/wasm-runner.js helloprintf_wasm.wasm | cmp /dev/stdin helloprintf_wasm.expected.txt


# Windows amd64: PE32+ (6l -H 10), kernel32.dll GetStdHandle/WriteFile/
# ExitProcess via windows_amd64.s (mirrors macos_amd64.s/linux_amd64.s;
# see windows_amd64.s for why write()/exit() must realign the stack).
# 6l -H 10 never produces a PIE/ASLR image, so no -z here (unlike
# macos_amd64.exe below, where -H6 forces PIE).
#
# claude: was BLOCKED 2026-07-24 - 2026-07-27 -- compiling
# print_nofloat_no64.c with plain `6c -Damd64` failed deterministically
# ("cant rewrite typestr for op NE" on `if(*p != '%') continue;`), and
# adding -z to route around it turned that into a nondeterministic
# segfault instead (memory fault, ~5/5 repro). Both symptoms traced to
# the same root cause, not a Windows-specific bug at all: compilers/cck/
# macbody's gethunk() had been switched from sbrk() to malloc() for an
# unrelated macOS/arm64 fix, but unlike sbrk() malloc() doesn't zero its
# memory, and this codebase's whole hunk allocator (used by every 6c
# compile, not just this one) relies on freshly carved structs being
# zero except the fields explicitly set. Fixed by zeroing the arena
# (see compilers/cck/macbody and docs/claude_notes/notes_os_windows.txt);
# both symptoms above disappeared after that fix plus a full toolchain
# rebuild (`mk install`, since assemblers/compilers that #include
# macbody directly aren't relinked just by editing it -- their .o files
# have to be forced stale, e.g. by touching/removing them, for mk to
# notice).
helloprintf_windows_amd64.exe: helloprintf.c
   6c -Damd64 -c test.c
   6c -Damd64 -c print_nofloat_no64.c
   6c -Damd64 -c helloprintf.c
   6a -Damd64 -c windows_amd64.s
   iar rc libprint.a windows_amd64.6 print*.6 test.6
   6l -s -H 10 -L. -o $target -E _main helloprintf.6

# 6c code generation regression test (reuses the print/stub objects
# built by the helloprintf rule above); same regress7c.c as macOS
regress7c_windows_amd64.exe: regress7c.c helloprintf_windows_amd64.exe
   6c -Damd64 -c regress7c.c
   6l -s -H 10 -L. -o $target -E _main regress7c.6

# runs natively on the Windows test host (no wine needed -- the host IS
# Windows here, unlike the wine-under-Linux path in ../../s/mini/mkfile's
# `test` target). Driven from the top-level `mk test_windows`.
test_windows:V: helloprintf_windows_amd64.exe regress7c_windows_amd64.exe
	./helloprintf_windows_amd64.exe | cmp /dev/stdin helloprintf.expected.txt
	./regress7c_windows_amd64.exe


# useful when troubleshooting issues to just get rid of the use of ar and
# get rid of float/64 bits instructions and see if everything
# else works at least
helloprintf_nofloat_no64.exe: helloprintf.c
   $CC $CPP_FLAGS -c print_nofloat_no64.c
   $CC $CPP_FLAGS -c helloprintf.c
   $AS $CPP_FLAGS -c linux_$objtype.s
   #$AR rc libprint.a linux_$objtype.$O print_nofloat_no64.$O
   $LD -L. -o $target -E main helloprintf.$O linux_$objtype.$O print_nofloat_no64.$O
