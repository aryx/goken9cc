# can use $CC -S to see the assembly code
TOP=../../..
<$TOP/mkfiles/$objtype/mkfile

all:V: helloc.exe
clean:V:
        rm -f *.[5678ijqvz] *.exe *.a
test_one:V:
        mk 'objtype='$cputype all
        ./helloc.exe | cmp /dev/stdin helloc.expected.txt

#TODO? 'ar rc'? in principia we use 'ar vu'
#old: $LD -X to require NOSPLIT for all linked code, especially in $stem.6
#alt: ar rc libmini.a *.$O   below
helloc.exe: helloc.c
   $CC -D$objtype -c $prereq
   $AS -D$objtype -c start_$objtype.s
   $AS -D$objtype -c xwrite_$objtype.s
   $AS -D$objtype -c xexit_$objtype.s
   $AR rc libmini.a start_$objtype.$O xwrite_$objtype.$O xexit_$objtype.$O
   $LD -L. -o $target -E _start helloc.$O

ARCHS=386 amd64 arm arm64 mips riscv alpha power
test:V:
        for (arch in $ARCHS) {
           echo $arch
           mk clean
           mk 'objtype='$arch
           $TOP/scripts/qemu-runner $arch ./helloc.exe | cmp /dev/stdin helloc.expected.txt
        }


# runs natively on Apple Silicon (no qemu needed)
test_macos_arm64:V: helloc_macos_arm64.exe
        ./helloc_macos_arm64.exe | cmp /dev/stdin helloc.expected.txt

# macOS arm64: same helloc.c but with the Darwin syscall stubs, the
# Mach-O header (-H6) and the mandatory ad-hoc code signature
# (see docs/notes_macos.txt); start_arm64.s is OS-independent so it
# is reused as-is. Runs natively on Apple Silicon.
helloc_macos_arm64.exe: helloc.c
   7c -Darm64 -c helloc.c
   7a -Darm64 -c start_arm64.s
   7a -Darm64 -c xwrite_macos_arm64.s
   7a -Darm64 -c xexit_macos_arm64.s
   iar rc libmini.a start_arm64.7 xwrite_macos_arm64.7 xexit_macos_arm64.7
   7l -H6 -L. -o $target -E _start helloc.7
   if(~ `{uname} Darwin) codesign -s - -f $target
   if not true

# runs natively on Intel Macs (no qemu needed)
# the cmp is not just belt-and-suspenders here: this target is what caught
# a real 6lg bug (see the comment on helloc_macos_amd64.exe below) where the
# binary linked, ran, and exited 0 while writing nothing at all -- a bare
# "it ran" check would have passed.
test_macos_amd64:V: helloc_macos_amd64.exe
        ./helloc_macos_amd64.exe | cmp /dev/stdin helloc.expected.txt

# macOS amd64: same helloc.c but with the Darwin syscall stubs (BSD
# syscall numbers OR'd with the 0x2000000 Unix class bit, see
# tests/s/mini/hello_macos_amd64.s) and the Mach-O header (-H6);
# start_amd64.s is OS-independent so it is reused as-is. Runs
# natively on Intel Macs.
#
# 6cg used to compile "xwrite(\"str\", n)" into "MOVQ $sym(SB), R" --
# the address of the string constant loaded as a link-time absolute
# immediate. That is fine for non-PIE ELF/PE, but 6lg -H6 always sets
# MH_PIE, so the kernel slides the image at exec() and the baked-in
# address is wrong; write() then silently fails (unchecked in xwrite)
# and the program exits 0 having printed nothing. 6cg's own linker
# (src/cmd/6l/span.c oclass()) worked around this at the HEADTYPE==6
# case without needing a compiler flag. This project's own 6c/6l (see
# tests/c/mini2's helloprintf_macos_amd64.exe) instead requires -z on
# the compiler side for PIE-safe codegen, same as pievar_amd64.c in
# tests/c/variants -- see docs/notes_macos.txt.

helloc_macos_amd64.exe: helloc.c
   6c -z -Damd64 -c helloc.c
   6a -Damd64 -c start_amd64.s
   6a -Damd64 -c xwrite_macos_amd64.s
   6a -Damd64 -c xexit_macos_amd64.s
   iar rc libmini.a start_amd64.6 xwrite_macos_amd64.6 xexit_macos_amd64.6
   6l -s -H6 -L. -o $target -E _start helloc.6
   if(~ `{uname} Darwin) codesign -s - -f $target
   if not true


# Windows amd64: PE32+ (6l -H 10), kernel32.dll GetStdHandle/WriteFile/
# ExitProcess via xwrite_windows_amd64.s/xexit_windows_amd64.s (mirrors
# xwrite_macos_amd64.s/xexit_macos_amd64.s -- same helloc.c, same
# start_amd64.s reused as-is since it is OS-independent). 6l -H 10 never
# produces a PIE/ASLR image, so no -z here (unlike helloc_macos_amd64.exe
# above, where -H6 forces PIE). Runs natively on the Windows test host
# (no wine needed -- the host IS Windows here, unlike the wine-under-Linux
# path in ../../s/mini/mkfile's `test` target). Driven from the top-level
# `mk test_windows`.
helloc_windows_amd64.exe: helloc.c
   6c -Damd64 -c helloc.c
   6a -Damd64 -c start_amd64.s
   6a -Damd64 -c xwrite_windows_amd64.s
   6a -Damd64 -c xexit_windows_amd64.s
   iar rc libmini.a start_amd64.6 xwrite_windows_amd64.6 xexit_windows_amd64.6
   6l -s -H 10 -L. -o $target -E _start helloc.6

test_windows:V: helloc_windows_amd64.exe
        ./helloc_windows_amd64.exe | cmp /dev/stdin helloc.expected.txt

