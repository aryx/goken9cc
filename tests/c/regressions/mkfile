warn_default_visible.check:V: hex_const_no_suffix_truncated.c
	7c -Darm64 -c hex_const_no_suffix_truncated.c >/tmp/warn_default.$pid.out >[2=1]
	n=`{grep -c 'truncated constant' /tmp/warn_default.$pid.out}
	if (~ $n 1)
		echo 'ok: 7c shows truncated-constant warning by default'
	if not {
		echo 'FAILED: 7c did not warn by default (got '$n' matches)'
		exit failed
	}
	7c -q -Darm64 -c hex_const_no_suffix_truncated.c >/tmp/warn_q.$pid.out >[2=1]
	n=`{grep -c 'truncated constant' /tmp/warn_q.$pid.out}
	if (~ $n 0)
		echo 'ok: 7c -q suppresses the warning'
	if not {
		echo 'FAILED: 7c -q did not suppress the warning (got '$n' matches)'
		exit failed
	}
	6c -Damd64 -c hex_const_no_suffix_truncated.c >/tmp/warn_default6.$pid.out >[2=1]
	n=`{grep -c 'truncated constant' /tmp/warn_default6.$pid.out}
	if (~ $n 1)
		echo 'ok: 6c shows truncated-constant warning by default'
	if not {
		echo 'FAILED: 6c did not warn by default (got '$n' matches)'
		exit failed
	}
	6c -q -Damd64 -c hex_const_no_suffix_truncated.c >/tmp/warn_q6.$pid.out >[2=1]
	n=`{grep -c 'truncated constant' /tmp/warn_q6.$pid.out}
	if (~ $n 0)
		echo 'ok: 6c -q suppresses the warning'
	if not {
		echo 'FAILED: 6c -q did not suppress the warning (got '$n' matches)'
		exit failed
	}
	rm -f /tmp/warn_default.$pid.out /tmp/warn_q.$pid.out /tmp/warn_default6.$pid.out /tmp/warn_q6.$pid.out

